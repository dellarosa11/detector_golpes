# Pasta que contém config.json, tokenizer.json e model.safetensors.
MODEL_PATH=models/bertimbau-smishing-v2
# Limites usados para converter a probabilidade em baixo, médio ou alto.
LOW_RISK_THRESHOLD=0.35
HIGH_RISK_THRESHOLD=0.70
# Tamanho máximo do print recebido pela API depois da compressão no celular.
MAX_IMAGE_BYTES=4194304
# false apenas no desenvolvimento; em produção deve permanecer true.
REQUIRE_FIREBASE_AUTH=false
